{
  "name": "lumen-player",
  "productName": "Lumen",
  "version": "0.6.2",
  "description": "A luminous home for your videos \u2014 a modern Windows video player.",
  "main": "out/main/index.js",
  "type": "module",
  "author": "Lumen",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:surface": "node scripts/build-surface.mjs",
    "dev": "npm run build:surface && electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "relay": "vite-node --config vitest.config.ts server/relay.ts",
    "start": "electron-vite preview",
    "build": "npm run typecheck && npm run build:surface && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "node scripts/clean-release.mjs && npm run build:surface && electron-vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "latest",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "app.lumen.player",
    "productName": "Lumen",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/surface/Lumen.SurfaceHost.exe",
        "to": "surface/Lumen.SurfaceHost.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp4",
            "m4v",
            "mov",
            "webm",
            "ogv",
            "mkv",
            "avi",
            "divx",
            "wmv",
            "asf",
            "flv",
            "f4v",
            "mpg",
            "mpeg",
            "mpe",
            "vob",
            "ts",
            "m2ts",
            "mts",
            "mxf",
            "3gp",
            "3g2",
            "ogm",
            "rm",
            "rmvb",
            "wtv",
            "dvr-ms"
          ],
          "name": "Lumen video"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "StizzyBee",
        "repo": "Lumen-Video-Player"
      }
    ]
  }
}
